# Text_To_Voice — Environment Variables
# Copy this file to .env and fill in your values

# ============================================================
# Provider API Keys
# ============================================================

# Google Gemini (TTS + LLM)
# Model: gemini-2.5-flash-preview-tts (TTS), gemini-3-flash-preview (LLM)
# Supports: single-speaker TTS, multi-speaker dialogue, LLM chat
GEMINI_API_KEY=

# OpenAI (TTS + LLM)
# Model: tts-1, tts-1-hd, gpt-4o-mini-tts (TTS), gpt-4o-mini (LLM)
# Supports: single-speaker TTS, voice instructions (gpt-4o-mini-tts only)
OPENAI_API_KEY=

# OpenRouter (LLM + TTS via compatible API)
# Proxies to OpenAI and other providers via OpenRouter API
# Base URL: https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# Custom OpenAI-Compatible Provider (any provider: 9router, LocalAI, vLLM, etc.)
# Base URL should include /v1 if needed (e.g. http://localhost:20128/v1)
CUSTOM_PROVIDER_NAME=
CUSTOM_PROVIDER_BASE_URL=
CUSTOM_PROVIDER_API_KEY=
CUSTOM_PROVIDER_TTS_MODEL=tts-1
CUSTOM_PROVIDER_LLM_MODEL=gpt-4o-mini
CUSTOM_PROVIDER_DEFAULT_VOICE=alloy

# Provider selection priority: custom > openai > gemini > openrouter
# If multiple keys are set, the server auto-selects based on availability

# ============================================================
# Server Configuration
# ============================================================

# Port server API
PORT=3001

# CORS origin (frontend URL)
CORS_ORIGIN=http://localhost:3000

# ============================================================
# Rate Limiting
# ============================================================

# Max requests per minute per IP
RATE_LIMIT_MAX=60

# Rate limit window in milliseconds (default: 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# ============================================================
# Audio Configuration
# ============================================================

# Default output format: wav | mp3 | ogg
DEFAULT_AUDIO_FORMAT=wav

# Max text length per TTS request (characters)
MAX_TTS_TEXT_LENGTH=4096

# ============================================================
# Logging
# ============================================================

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Enable request logging
ENABLE_REQUEST_LOG=true

# ============================================================
# Plugins
# ============================================================

# Audio cache plugin — cache TTS responses in memory
CACHE_MAX_SIZE=100
CACHE_TTL_MS=1800000

# Webhook plugin — notify external service on TTS/LLM completion
WEBHOOK_URL=
WEBHOOK_SECRET=
